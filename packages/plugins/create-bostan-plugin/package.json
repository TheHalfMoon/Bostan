    "clean": "rm -rf dist",
    "test": "pnpm -w exec vitest run --root packages/plugins/create-bostan-plugin --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@bostan/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
