{
  "name": "@bostan/plugin-hello-world-example",
  "version": "0.1.0",
  "description": "First-party reference plugin that adds a Hello World dashboard widget",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "prebuild": "pnpm --filter @bostan/plugin-sdk ensure-build-deps",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @bostan/plugin-sdk ensure-build-deps && tsc --noEmit",
    "prepack": "node ../../../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@bostan/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/plugins/examples/plugin-hello-world-example"
  }
}
