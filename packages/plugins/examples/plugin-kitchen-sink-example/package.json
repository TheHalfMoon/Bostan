{
  "name": "@bostan/plugin-kitchen-sink-example",
  "version": "0.1.0",
  "description": "Reference plugin that demonstrates the full Bostan plugin surface area in one package",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "prebuild": "pnpm --filter @bostan/plugin-sdk ensure-build-deps",
    "build": "tsc && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @bostan/plugin-sdk ensure-build-deps && tsc --noEmit",
    "prepack": "node ../../../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@bostan/plugin-sdk": "workspace:*",
    "@bostan/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "homepage": "https://github.com/TheHalfMoon/Bostan"
}
