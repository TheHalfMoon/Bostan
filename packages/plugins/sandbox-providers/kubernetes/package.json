{
  "name": "@bostan/plugin-kubernetes",
  "version": "0.1.0",
  "description": "Kubernetes sandbox provider plugin for Bostan environments",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/plugins/sandbox-providers/kubernetes"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "manifests",
    "README.md"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": [
    "bostan",
    "plugin",
    "sandbox",
    "kubernetes"
  ],
  "scripts": {
    "prebuild": "pnpm -C ../../../.. --filter @bostan/plugin-sdk ensure-build-deps",
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm -C ../../../.. --filter @bostan/plugin-sdk ensure-build-deps && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "node ../../../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "private": true
}
