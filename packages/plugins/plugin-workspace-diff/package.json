{
  "name": "@bostan/plugin-workspace-diff",
  "version": "0.1.0",
  "description": "First-party execution workspace Changes tab powered by plugin-local workspace metadata",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/plugins/plugin-workspace-diff"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "bostan",
    "plugin",
    "workspace",
    "diff"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @bostan/plugin-sdk ensure-build-deps",
    "build": "tsc && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @bostan/plugin-sdk ensure-build-deps && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node ../../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@bostan/plugin-sdk": "workspace:*",
    "@pierre/diffs": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "private": true
}
