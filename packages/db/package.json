{
  "name": "@bostan/db",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/db"
  },
  "type": "module",
  "exports": {
    ".": { "bostan-compiled": "./dist/index.js", "default": "./src/index.ts" },
    "./*": { "bostan-compiled": "./dist/*.js", "default": "./src/*.ts" }
  },
  "files": [
    "dist"
  ],
  "bundleDependencies": [
    "embedded-postgres"
  ],
  "scripts": {
    "check:migrations": "tsx src/check-migration-numbering.ts && tsx src/check-migration-safety.ts",
    "build": "pnpm run check:migrations && tsc && node scripts/copy-migrations.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm run check:migrations && tsc --noEmit",
    "generate": "pnpm run check:migrations && pnpm run clean && tsc -p tsconfig.json && drizzle-kit generate && pnpm run prune:snapshots",
    "prune:snapshots": "ls src/migrations/meta/*_snapshot.json | sort -r | tail -n +6 | xargs rm -f",
    "migrate": "pnpm run check:migrations && tsx src/migrate.ts",
    "seed": "pnpm --filter @bostan/server exec tsx scripts/seed.ts",
    "prepack": "node ../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@bostan/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "^18.1.0-beta.16",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "private": true
}
