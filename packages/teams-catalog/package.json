{
  "name": "@bostan/teams-catalog",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/teams-catalog"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./catalog.json": "./generated/catalog.json"
  },
  "files": [
    "catalog",
    "dist",
    "generated"
  ],
  "scripts": {
    "prepack": "node ../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../scripts/bostan-release-disabled.mjs",
    "build": "pnpm run build:manifest && tsc -p tsconfig.json",
    "build:manifest": "node ../../server/node_modules/tsx/dist/cli.mjs scripts/build-catalog-manifest.ts",
    "clean": "rm -rf dist",
    "test": "pnpm -w exec vitest run --root packages/teams-catalog --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node ../../server/node_modules/tsx/dist/cli.mjs scripts/validate-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
