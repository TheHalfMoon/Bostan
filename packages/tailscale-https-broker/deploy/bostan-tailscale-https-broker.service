[Unit]
Description=Bostan Tailscale HTTPS broker
After=tailscaled.service
Requires=tailscaled.service

[Service]
Type=simple
User=bostan-tsbroker
Group=bostan-tsbroker-sock
EnvironmentFile=/etc/bostan/tailscale-https-broker.env
ExecStart=/usr/bin/node /opt/bostan/packages/tailscale-https-broker/dist/main.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=bostan-tailscale-broker
RuntimeDirectoryMode=0750
StateDirectory=bostan-tailscale-broker
StateDirectoryMode=0700
LogsDirectory=bostan-tailscale-broker
LogsDirectoryMode=0700
ReadWritePaths=/run/bostan-tailscale-broker /var/lib/bostan-tailscale-broker /var/log/bostan-tailscale-broker

[Install]
WantedBy=multi-user.target
