{
  "name": "@bostan/shared",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/shared"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/cliplab && cp src/cliplab/LICENSE src/cliplab/PROVENANCE.md dist/cliplab/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "@types/three": "0.185.4"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "private": true
}
