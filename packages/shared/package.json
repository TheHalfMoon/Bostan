{
  "name": "@bostan/shared",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/shared"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "bostan-compiled": "./dist/index.js", "default": "./src/index.ts" },
    "./telemetry": { "bostan-compiled": "./dist/telemetry/index.js", "default": "./src/telemetry/index.ts" },
    "./*": { "bostan-compiled": "./dist/*.js", "default": "./src/*.ts" }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-cliplab-notices.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "@types/three": "0.185.4"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "private": true
}
