{
  "name": "@bostan/adapter-grok-local",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/TheHalfMoon/Bostan",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Bostan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Bostan",
    "directory": "packages/adapters/grok-local"
  },
  "type": "module",
  "exports": {
    ".": { "bostan-compiled": "./dist/index.js", "default": "./src/index.ts" },
    "./server": { "bostan-compiled": "./dist/server/index.js", "default": "./src/server/index.ts" },
    "./ui": { "bostan-compiled": "./dist/ui/index.js", "default": "./src/ui/index.ts" },
    "./cli": { "bostan-compiled": "./dist/cli/index.js", "default": "./src/cli/index.ts" }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-build-assets.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../../scripts/bostan-release-disabled.mjs",
    "prepublishOnly": "node ../../../scripts/bostan-release-disabled.mjs"
  },
  "dependencies": {
    "@bostan/adapter-utils": "workspace:*",
    "@bostan/shared": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "private": true,
  "keywords": []
}
